# From your app at https://developer.kroger.com (My Apps -> your app)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional. Must match the redirect URL registered on the Kroger app: http://localhost:<PORT>/callback
PORT=8000
# Optional. Photo suggestions run the installed Claude Code (claude -p) on this PC with this model.
PHOTO_MODEL=claude-opus-5
# Optional. Seconds to wait for a photo analysis before giving up.
PHOTO_TIMEOUT=90
