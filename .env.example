# Required. From your app at https://developer.kroger.com (My Apps -> your app).
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Optional. Port to listen on. The Kroger app's redirect URL must match: <PUBLIC_URL>/callback
PORT=8000

# Optional. How browsers reach this server when it runs on another machine (a NAS, a Pi, Docker on a
# server). Register <PUBLIC_URL>/callback as the redirect URL on your Kroger app. Leave unset when the
# app runs on the PC you sign in from (default http://localhost:<PORT>).
#PUBLIC_URL=http://nas.local:8000

# Optional. Folder for lists, config, tokens, and order history. Default: ./data
#KROGER_REORDER_DATA=./data

# Optional. Photo and recipe suggestions. Set an Anthropic API key (https://console.anthropic.com) and
# both go through the API, pay-per-use. Leave unset and the app runs Claude Code (`claude -p`) on this
# computer instead, on its signed-in subscription.
#ANTHROPIC_API_KEY=

# Optional. Model for photo and recipe suggestions, used by both backends.
PHOTO_MODEL=claude-opus-5-5
# Optional. Seconds to wait for photo and recipe suggestions before giving up.
PHOTO_TIMEOUT=90

# Optional. Aldi lists read products and prices from aldi.us by replaying the site's own search
# requests. Instacart, which runs the site, renames those requests from time to time; when Aldi
# search reports "Aldi's site changed", paste the new hashes here (see README, Troubleshooting).
#ALDI_SEARCH_HASH=
#ALDI_ITEMS_HASH=
#ALDI_LOCATION_HASH=
